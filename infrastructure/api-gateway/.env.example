# LivingDocs API Gateway - LIV-115
# Copy thành .env để cấu hình local.

# HTTP listeners
GATEWAY_PORT=8081
GATEWAY_BIND_ADDRESS=127.0.0.1

# Management / Actuator
GATEWAY_MANAGEMENT_PORT=9091
GATEWAY_MANAGEMENT_ADDRESS=127.0.0.1

# Downstream service URIs
S01_SERVICE_URI=http://127.0.0.1:8082
S02_SERVICE_URI=http://127.0.0.1:8083
S04_SERVICE_URI=http://127.0.0.1:8084

# CORS
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# HTTP client timeout
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s

# JWT - điền sau khi S01 cung cấp contract thật.
# JWT_ISSUER_URI=
# JWT_AUDIENCE=

# Chỉ dùng sau khi chốt JWKS URL với S01
# và khai báo jwt.jwk-set-uri tương ứng.
# JWT_JWK_SET_URI=