# LivingDocs API Gateway - LIV-115
# Copy thành .env để cấu hình local.

# HTTP listeners
GATEWAY_PORT=8080
GATEWAY_BIND_ADDRESS=127.0.0.1

# Management / Actuator
GATEWAY_MANAGEMENT_PORT=9091
GATEWAY_MANAGEMENT_ADDRESS=127.0.0.1

# Downstream service URIs
S01_SERVICE_URI=http://127.0.0.1:8081
S02_SERVICE_URI=http://127.0.0.1:8082
S04_SERVICE_URI=http://127.0.0.1:8084

# CORS
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# HTTP client timeout
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=5s

# S01 JWT trust contract. JWKS URL must be reachable from this process.
# JWT verification
# Phải khớp issuer/audience của S01.
JWT_ISSUER_URI=urn:livingdocs:s01
JWT_AUDIENCE=livingdocs-api
JWT_JWK_SET_URI=http://127.0.0.1:8081/.well-known/jwks.json
