# PostgreSQL 17 - môi trường local LivingDocs

POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_HOST_PORT=5432

KAFKA_HOST_PORT=9092
REDIS_HOST_PORT=6379
AI_SERVICE_HOST_PORT=8000

# S01
S01_DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
S01_FLYWAY_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Thư mục chứa JWT key và pepper trên máy host.
# Đường dẫn tương đối với infrastructure/docker/compose.yaml.
# Compose mount vào /run/secrets:ro trong S01 container.
S01_JWT_SECRETS_DIR=../../../livingdocs-secrets

# Optional previous public key path inside /run/secrets during rotation.
# Optional: public key cũ khi rotation.
S01_PREVIOUS_PUBLIC_KEY_PATH=

# S02
S02_DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
S02_FLYWAY_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# S04
S04_DB_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
S04_FLYWAY_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# Gateway JWT trust; JWKS URL is internal Compose DNS.
JWT_ISSUER_URI=urn:livingdocs:s01
JWT_AUDIENCE=livingdocs-api
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000
