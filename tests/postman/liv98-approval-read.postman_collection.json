        {
          "name": "API-123 context returns history, evidence and ETag",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/v1/document-versions/{{olderVersionId}}/approval-context",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "liv98-newman"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 APPROVAL_CONTEXT_LOADED', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().code).to.eql('APPROVAL_CONTEXT_LOADED'); });",
                  "pm.test('Strong ETag bound to version and revision', () => pm.expect(pm.response.headers.get('ETag')).to.eql('\"' + pm.environment.get('olderVersionId') + ':revision-2\"'));",
                  "pm.test('Context body', () => { const d = pm.response.json().data;",
                  "  pm.expect(d.awaitingManagerDecision).to.eql(true); pm.expect(d.version.versionId).to.eql(pm.environment.get('olderVersionId'));",
                  "  pm.expect(d.version.reviewStage).to.eql('MANAGER_APPROVAL'); pm.expect(d.version.sourceBinding.repositoryConnectionId).to.eql(pm.environment.get('repositoryId'));",
                  "  pm.expect(d.currentContent.revisionNo).to.eql(2); pm.expect(d.staffDecisions[0].decision).to.eql('PASS');",
                  "  pm.expect(d.approvalDecisions[0].decision).to.eql('RETURN_TO_STAFF'); pm.expect(d.evidence[0].evidenceId).to.eql(pm.environment.get('evidenceId')); });"
                ]
              }
            }
          ]
        },
