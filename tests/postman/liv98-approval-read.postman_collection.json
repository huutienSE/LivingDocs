{
  "info": {
    "name": "LIV-98 API-122/123 Manager approval reads",
    "description": "Run all folders through scripts/test_api122_123_integration.py --newman. Real S01 login/API-038, real Gateway and S04 on disposable PostgreSQL/Redis. Versions are placed at MANAGER_APPROVAL with CONTROLLED SQL fixtures because a real Staff PASS needs the S02 source adapter that does not exist yet (see LIV-118 report). The runner owns role/outage phase changes and DB readback; running folders without those phase changes is invalid. Credentials and raw reports stay temporary.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Manager reads",
      "item": [
        {
          "name": "Login Manager with real S01 credentials",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "liv98-newman"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{managerEmail}}\",\"password\":\"{{managerPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('S01 issues a real User JWT through the Gateway', () => { pm.response.to.have.status(200);",
                  "  const t = pm.response.json().data.accessToken; pm.expect(t.split('.')).to.have.length(3);",
                  "  pm.environment.set('managerToken', t); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Manager scope comes from S01 API-038",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/v1/users/me/access-context",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "liv98-newman"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API-038 grants MANAGER + DOCUMENT_FINAL_APPROVE on the verified repository', () => { pm.response.to.have.status(200);",
                  "  const g = pm.response.json().data.workspaceGrants.find(x => x.workspaceId === pm.environment.get('workspaceId'));",
                  "  pm.expect(g.roles).to.include('MANAGER'); pm.expect(g.permissions).to.include('DOCUMENT_FINAL_APPROVE');",
                  "  pm.expect(g.repositoryIds).to.include(pm.environment.get('repositoryId')); });"
                ]
              }
            }
          ]
        },
        {
          "name": "API-122 queue lists only in-scope Manager Approval versions, oldest PASS first",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/v1/approval-queue",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-ID",
                "value": "liv98-newman"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{managerToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 APPROVAL_QUEUE_LOADED with no-store', () => { pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().code).to.eql('APPROVAL_QUEUE_LOADED');",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
                  "pm.test('Exactly the expected versions, in order', () => {",
                  "  const d = pm.response.json().data; const ids = d.items.map(i => i.versionId);",
                  "  pm.expect(ids).to.eql([pm.environment.get('olderVersionId'), pm.environment.get('newerVersionId'), pm.environment.get('repositoryFreeVersionId')]);",
                  "  pm.expect(d.totalElements).to.eql(3); pm.expect(d.totalPages).to.eql(1); });",
                  "pm.test('Excluded: Staff Review, ungranted repository, other workspace, other tenant', () => {",
                  "  const ids = pm.response.json().data.items.map(i => i.versionId);",
                  "  ['staffStageVersionId','otherRepoVersionId','otherWorkspaceVersionId','foreignVersionId'].forEach(k => pm.expect(ids).to.not.include(pm.environment.get(k))); });",
                  "pm.test('Item fields', () => { const i = pm.response.json().data.items[0];",
                  "  pm.expect(i.state).to.eql('IN_REVIEW'); pm.expect(i.reviewStage).to.eql('MANAGER_APPROVAL');",
                  "  pm.expect(i.workspaceId).to.eql(pm.environment.get('workspaceId')); pm.expect(i.repositoryConnectionId).to.eql(pm.environment.get('repositoryId'));",
                  "  pm.expect(i.staffPassedAt).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
