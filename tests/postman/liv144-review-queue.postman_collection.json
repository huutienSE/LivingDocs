      "item": [
        {
          "name": "Only granted candidates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "liv144-newman"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/review-queue"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Scoped queue envelope', () => { pm.expect(body.code).to.eql('REVIEW_QUEUE_LOADED'); pm.expect(body.data.items).to.be.an('array'); pm.expect(body.data.totalElements).to.be.a('number'); });",
                  "pm.test('No cache and correlation', () => { pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'); pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql('liv144-newman'); });",
                  "pm.test('Business assertion', () => { pm.expect(body.data.totalElements).to.eql(2); pm.expect(body.data.items.map(x=>x.versionId)).to.have.members([pm.environment.get('versionId'),pm.environment.get('secondaryVersionId')]); body.data.items.forEach(x=>{pm.expect(x.workspaceId).to.eql(pm.environment.get('workspaceId')); pm.expect(x.repositoryConnectionId).to.eql(pm.environment.get('repositoryId'));pm.expect(x.state).to.eql('IN_REVIEW');pm.expect(x.reviewStage).to.eql('STAFF_REVIEW');}); });"
                ]
              }
            }
          ]
