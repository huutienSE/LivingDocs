{
  "info": {
    "name": "LIV-137 API-002 Login, JWKS and Gateway authentication",
    "description": "Run folders in order against local S01 :8081 and Gateway :8080. Gateway valid-Bearer probe targets candidate /api/v1/users/me and currently expects downstream 404; it does not prove domain business authorization. Access tokens remain in run-local variables and are never exported.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8081"
    },
    {
      "key": "gatewayUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "A-secure-password-123"
    },
    {
      "key": "rateEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flow 1 - S01 credentials and JWKS",
      "item": [
        {
          "name": "01 Register a fresh identity",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('email', 'liv137-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
                  "pm.collectionVariables.set('rateEmail', 'liv137-rate-' + pm.variables.replaceIn('{{$guid}}') + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register 201', () => pm.response.to.have.status(201));",
                  "pm.test('Register returns identityId without JWT', () => { const data = pm.response.json().data; pm.expect(data.identityId).to.match(/^[0-9a-f-]{36}$/i); pm.expect(pm.response.text()).not.to.include('accessToken'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "02 Login returns access JWT only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login 200 JSON no-store', () => { pm.response.to.have.status(200); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });",
                  "const body = pm.response.json();",
                  "pm.test('Exact access-token-only wrapper', () => { pm.expect(body.code).to.eql('LOGIN_SUCCEEDED'); pm.expect(body.data.tokenType).to.eql('Bearer'); pm.expect(body.data.expiresIn).to.eql(900); pm.expect(Object.keys(body.data).sort()).to.eql(['accessToken','expiresIn','tokenType']); });",
                  "const token = body.data.accessToken; const parts = token.split('.');",
                  "pm.test('JWT claims and lifetime', () => { pm.expect(parts).to.have.length(3); const header = JSON.parse(atob(parts[0].replace(/-/g,'+').replace(/_/g,'/'))); const claims = JSON.parse(atob(parts[1].replace(/-/g,'+').replace(/_/g,'/'))); pm.expect(header.alg).to.eql('RS256'); pm.expect(header.kid).to.be.a('string').and.not.empty; pm.expect(claims.sub).to.match(/^[0-9a-f-]{36}$/i); pm.expect(claims.iss).to.eql('urn:livingdocs:s01'); pm.expect(claims.aud).to.include('livingdocs-api'); pm.expect(claims.exp - claims.iat).to.eql(900); pm.expect(claims.nbf).to.be.a('number'); ['tenant_id','roles','permissions'].forEach(k => pm.expect(claims).not.to.have.property(k)); pm.variables.set('jwtKid', header.kid); });",
                  "pm.variables.set('accessToken', token);",
                  "pm.variables.set('tamperedToken', parts[0] + '.' + parts[1] + '.' + (parts[2][0] === 'A' ? 'B' : 'A') + parts[2].slice(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 Login normalizes email case and outer spaces",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.variables.set('emailUpper', pm.collectionVariables.get('email').toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Normalized email login 200', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().code).to.eql('LOGIN_SUCCEEDED'); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"  {{emailUpper}}  \",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "04 JWKS publishes public RSA key only",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('JWKS 200 and public only', () => { pm.response.to.have.status(200); const keys = pm.response.json().keys; pm.expect(keys).to.be.an('array').that.is.not.empty; keys.forEach(k => { pm.expect(k.kty).to.eql('RSA'); pm.expect(k.kid).to.be.a('string').and.not.empty; ['d','p','q','dp','dq','qi'].forEach(secret => pm.expect(k).not.to.have.property(secret)); }); pm.expect(keys.map(k => k.kid)).to.include(pm.variables.get('jwtKid')); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/.well-known/jwks.json"
          }
        },
        {
          "name": "05 Wrong password is generic 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 401 INVALID_CREDENTIALS', () => pm.response.to.have.status(401));",
                  "const problem = pm.response.json();",
                  "pm.test('RFC 9457 INVALID_CREDENTIALS', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); pm.expect(problem.status).to.eql(401); pm.expect(problem.code).to.eql('INVALID_CREDENTIALS'); ['type','title','detail','instance','correlationId'].forEach(k => pm.expect(problem[k], k).to.be.a('string').and.not.empty); pm.expect(pm.response.text()).not.to.include('accessToken'); });",
                  "pm.test('Login response is not cached', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
                  "pm.test('No account disclosure', () => { const p = pm.response.json(); pm.expect(pm.response.text()).not.to.include(pm.collectionVariables.get('email')); pm.expect(pm.response.text()).not.to.include('wrong-password'); pm.variables.set('wrongCredentialPublicError', JSON.stringify([p.status,p.code,p.title,p.detail])); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
