                  "pm.test('HTTP 429 LOGIN_RATE_LIMITED', () => pm.response.to.have.status(429));",
                  "const problem = pm.response.json();",
                  "pm.test('RFC 9457 LOGIN_RATE_LIMITED', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); pm.expect(problem.status).to.eql(429); pm.expect(problem.code).to.eql('LOGIN_RATE_LIMITED'); ['type','title','detail','instance','correlationId'].forEach(k => pm.expect(problem[k], k).to.be.a('string').and.not.empty); pm.expect(pm.response.text()).not.to.include('accessToken'); });",
                  "pm.test('Login response is not cached', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));",
                  "pm.test('Retry-After is positive seconds', () => { const retry = Number(pm.response.headers.get('Retry-After')); pm.expect(retry).to.be.greaterThan(0); });"
