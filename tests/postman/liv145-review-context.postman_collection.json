  "item": [
    {
      "name": "01 Canonical context",
      "item": [
        {
          "name": "Content/template/baseline/evidence from S04",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "X-Correlation-ID",
                "value": "liv145-newman"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{gatewayUrl}}/api/v1/document-versions/{{versionId}}/review-context"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.code === 304 ? null : pm.response.json();",
                  "pm.test('Context envelope and canonical version', () => {pm.expect(body.code).to.eql('REVIEW_CONTEXT_LOADED');pm.expect(body.data.version.versionId).to.be.a('string');});",
                  "pm.test('Strong ETag/no-store/correlation', () => {pm.expect(pm.response.headers.get('ETag')).to.match(/^\"[0-9a-f-]{36}:revision-[0-9]+:context-[0-9a-f]{64}\"$/);pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store');pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql('liv145-newman');});",
                  "pm.test('Business assertion', () => {const d=body.data;pm.expect(d.content).to.eql('# Current candidate body');pm.expect(d.contentFormat).to.eql('MARKDOWN');pm.expect(d.contentRef).to.eql('artifact://current');pm.expect(d.contentRevisionNo).to.eql(2);pm.expect(d.versionNo).to.eql(3);pm.expect(d.template.templateVersionId).to.eql(pm.environment.get('templateVersionId'));pm.expect(d.template.formattingRules.headings).to.eql(['Overview']);pm.expect(d.baseline.versionId).to.eql(pm.environment.get('baselineVersionId'));pm.expect(d.baseline.content).to.eql('Published baseline body');pm.expect(d.evidence).to.have.lengthOf(2);pm.expect(d.evidence.map(e=>e.ref)).to.include(pm.environment.get('diffEvidenceId'));d.evidence.forEach(e=>pm.expect(e.ref).to.match(/^[a-f0-9-]{36}$/));pm.expect(d.submittedBy).to.be.a('string');pm.expect(d.reviewRound).to.eql(0);pm.environment.set('initialContextEtag',pm.response.headers.get('ETag'));pm.environment.set('contextEtag',pm.response.headers.get('ETag'));});"
                ]
              }
            }
          ]
        },
