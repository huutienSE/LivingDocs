{
  "info": {
    "name": "LIV-145 API-116 Staff Review Context",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run phased with scripts/test_api116_s01_integration.py on disposable Gateway/S01/S04/PostgreSQL/Redis. Real identity and fresh mutation authorization; SQL canonical-content/template/baseline/authority fixtures. No S02/artifact reader/FE proof."
  },
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "http://127.0.0.1:8080"
