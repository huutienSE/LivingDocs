          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 for changed metadata', () => pm.response.to.have.status(200));",
                  "pm.test('Updated metadata and unchanged version revision', () => {const d=pm.response.json().data;pm.expect(d.template.name).to.eql('Updated template metadata');pm.expect(d.version.revision).to.eql(1);});",
                  "pm.test('New strong representation validator', () => {const tag=pm.response.headers.get('ETag');pm.expect(tag).to.match(/^\"[0-9a-f-]{36}:revision-1:context-[0-9a-f]{64}\"$/);pm.expect(tag).not.to.eql(pm.environment.get('initialContextEtag'));pm.environment.set('contextEtag',tag);});"
                ]
              }
            }
          ]
        },
