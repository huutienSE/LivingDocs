                  "pm.test('Business assertion', () => {pm.expect(body.data.version.reviewStage).to.eql('STAFF_REVIEW');pm.expect(body.data.version.revision).to.eql(3);pm.expect(body.data.content).to.eql('# Current candidate body');pm.environment.set('contextEtag',pm.response.headers.get('ETag'));});"
                ]
              }
            }
