                  "pm.test(\"Không cache\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
                  "pm.test(\"Có correlation\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Xác minh quyền installation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/github/authorization?workspaceId={{workspaceId}}&authorizationContextId={{contextId}}&installationId={{installationId}}&installationPage={{installationPage}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status theo contract\", () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test(\"Không cache\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
                  "pm.test(\"Có correlation\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Repository người dùng truy cập",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/github/authorization-contexts/{{contextId}}/installations/{{installationId}}/repositories?page=1",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status theo contract\", () => pm.expect([200]).to.include(pm.response.code));",
                  "pm.test(\"Không cache\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
                  "pm.test(\"Có correlation\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Hủy context",
      "item": [
        {
          "name": "Hủy credential local",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/integrations/github/authorization-contexts/{{contextId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userJwt}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status theo contract\", () => pm.expect([204]).to.include(pm.response.code));",
                  "pm.test(\"Không cache\", () => pm.expect(pm.response.headers.get(\"Cache-Control\")).to.include(\"no-store\"));",
                  "pm.test(\"Có correlation\", () => pm.expect(pm.response.headers.get(\"X-Correlation-ID\")).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
