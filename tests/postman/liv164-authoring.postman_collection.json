{
  "info": {
    "name": "LIV-164 Developer authoring Flow 1 — isolated upstream fixtures",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Real Gateway/S01/S04; collection/grant/source snapshots are controlled test fixtures. Documents, versions and edits use HTTP APIs."
  },
  "item": [
    {
      "name": "Developer authoring demo",
      "item": [
        {
          "name": "01 Create Document",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/workspaces/{{workspaceId}}/documents",
            "body": {
              "mode": "raw",
              "raw": "{\"collectionId\": \"{{collectionId}}\", \"repositoryConnectionId\": \"{{repositoryId}}\", \"title\": \"LIV164 API demo\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_CREATED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_CREATED\"));",
                  "pm.environment.set(\"documentId\", result.data.documentId);",
                  "pm.test(\"No version yet\", () => pm.expect(result.data.currentVersionId).to.equal(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Read Document",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_LOADED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_LOADED\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Empty version list",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/versions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_VERSIONS_LOADED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_VERSIONS_LOADED\"));",
                  "pm.test(\"Empty history\", () => pm.expect(result.data.items).to.have.length(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Create Draft",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/versions",
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"# Initial Markdown\", \"sourceSnapshotId\": \"{{snapshotId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_VERSION_CREATED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_VERSION_CREATED\"));",
                  "pm.environment.set(\"versionId\", result.data.versionId);",
                  "pm.environment.set(\"draftEtag\", pm.response.headers.get(\"ETag\"));",
                  "pm.test(\"Draft\", () => pm.expect(result.data.state).to.equal(\"DRAFT\"));",
                  "pm.test(\"Initial revision\", () => pm.expect(result.data.revision).to.equal(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Read exact version",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_VERSION_LOADED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_VERSION_LOADED\"));",
                  "pm.test(\"Markdown\", () => pm.expect(result.data.content).to.equal(\"# Initial Markdown\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Edit Markdown",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "If-Match",
                "value": "{{draftEtag}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/content",
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"# Edited Markdown\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_CONTENT_UPDATED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_CONTENT_UPDATED\"));",
                  "pm.environment.set(\"editedEtag\", pm.response.headers.get(\"ETag\"));",
                  "pm.test(\"Revision increments\", () => pm.expect(result.data.revision).to.equal(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Stale edit rejected",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "If-Match",
                "value": "{{draftEtag}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/content",
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"lost edit\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 412\", () => pm.response.to.have.status(412));",
                  "const result = pm.response.json();",
                  "pm.test(\"REVISION_CONFLICT\", () => pm.expect(result.code).to.equal(\"REVISION_CONFLICT\"));",
                  "pm.test(\"Problem type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"Correlation\", () => pm.expect(pm.response.json().correlationId).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Missing ETag rejected",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/content",
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"lost edit\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 428\", () => pm.response.to.have.status(428));",
                  "const result = pm.response.json();",
                  "pm.test(\"PRECONDITION_REQUIRED\", () => pm.expect(result.code).to.equal(\"PRECONDITION_REQUIRED\"));",
                  "pm.test(\"Problem type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"Correlation\", () => pm.expect(pm.response.json().correlationId).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Read evidence",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/evidence"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_EVIDENCE_LOADED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_EVIDENCE_LOADED\"));",
                  "pm.test(\"Persisted source evidence\", () => pm.expect(result.data.evidence).to.have.length(1));",
                  "pm.test(\"Bound repository\", () => pm.expect(result.data.sourceBinding.repositoryConnectionId).to.equal(pm.environment.get(\"repositoryId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Version history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/documents/{{documentId}}/versions?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_VERSIONS_LOADED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_VERSIONS_LOADED\"));",
                  "pm.test(\"One version\", () => pm.expect(result.data.totalElements).to.equal(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Submit via LIV143",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "If-Match",
                "value": "{{editedEtag}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "liv164-demo-submit"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_SUBMITTED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_SUBMITTED\"));",
                  "pm.environment.set(\"submittedEtag\", pm.response.headers.get(\"ETag\"));",
                  "pm.environment.set(\"submissionBody\", pm.response.text());",
                  "pm.test(\"Staff Review\", () => pm.expect(result.data.reviewStage).to.equal(\"STAFF_REVIEW\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Submit replay",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "If-Match",
                "value": "{{editedEtag}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "liv164-demo-submit"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/submit",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_SUBMITTED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_SUBMITTED\"));",
                  "pm.test(\"Original response\", () => pm.expect(pm.response.text()).to.equal(pm.environment.get(\"submissionBody\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Submitted version cannot edit",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "If-Match",
                "value": "{{submittedEtag}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}/content",
            "body": {
              "mode": "raw",
              "raw": "{\"content\": \"forbidden\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "const result = pm.response.json();",
                  "pm.test(\"STATE_TRANSITION_FORBIDDEN\", () => pm.expect(result.code).to.equal(\"STATE_TRANSITION_FORBIDDEN\"));",
                  "pm.test(\"Problem type\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\"));",
                  "pm.test(\"Correlation\", () => pm.expect(pm.response.json().correlationId).to.be.a(\"string\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "14 Final readback",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const result = pm.response.json();",
                  "pm.test(\"DOCUMENT_VERSION_LOADED\", () => pm.expect(result.code).to.equal(\"DOCUMENT_VERSION_LOADED\"));",
                  "pm.test(\"Content preserved\", () => pm.expect(result.data.content).to.equal(\"# Edited Markdown\"));",
                  "pm.test(\"State persisted\", () => pm.expect(result.data.state).to.equal(\"IN_REVIEW\"));",
                  "pm.test(\"Review stage persisted\", () => pm.expect(result.data.reviewStage).to.equal(\"STAFF_REVIEW\"));",
                  "pm.test(\"Two mutations\", () => pm.expect(result.data.revision).to.equal(2));"
                ]
              }
            }
          ]
        },
        {
          "name": "15 Anonymous denied",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/document-versions/{{versionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
