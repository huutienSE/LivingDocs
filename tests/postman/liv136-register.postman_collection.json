{
  "info": {
    "name": "LIV-136 API-001 Register",
    "description": "Run against an isolated S01 PostgreSQL environment. No tokens or secrets are stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8081"},
    {"key": "password", "value": "A-secure-password-123"}
  ],
  "item": [
    {
      "name": "Register returns 201 wrapper",
      "event": [
        {"listen": "prerequest", "script": {"exec": ["pm.collectionVariables.set('registerEmail', 'liv136-' + Date.now() + '-' + Math.floor(Math.random() * 1000000) + '@example.com');"]}},
        {"listen": "test", "script": {"exec": [
          "pm.test('HTTP 201 JSON wrapper', () => { pm.response.to.have.status(201); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
          "const body = pm.response.json();",
          "pm.test('Typed success fields', () => { pm.expect(body.code).to.eql('IDENTITY_REGISTERED'); pm.expect(body.message).to.be.a('string'); pm.expect(body.data.identityId).to.match(/^[0-9a-f-]{36}$/i); pm.expect(body).not.to.have.property('password'); pm.expect(body.data).not.to.have.property('passwordHash'); });"
        ]}}
      ],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{registerEmail}}\",\"password\":\"{{password}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/register"}
    },
    {
      "name": "Duplicate email returns 409 Problem",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('HTTP 409 Problem', () => { pm.response.to.have.status(409); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });",
        "const body = pm.response.json();",
        "pm.test('Stable code without email disclosure', () => { pm.expect(body.code).to.eql('IDENTITY_ALREADY_EXISTS'); pm.expect(body.status).to.eql(409); pm.expect(body.correlationId).to.be.a('string'); pm.expect(JSON.stringify(body)).not.to.include(pm.collectionVariables.get('registerEmail')); });"
      ]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"{{registerEmail}}\",\"password\":\"{{password}}\"}"}, "url": "{{baseUrl}}/api/v1/auth/register"}
    },
    {
      "name": "Invalid password returns 400 Problem",
      "event": [{"listen": "test", "script": {"exec": [
        "pm.test('HTTP 400 Problem', () => { pm.response.to.have.status(400); pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });",
        "pm.test('Stable validation code', () => { const body = pm.response.json(); pm.expect(body.code).to.eql('INVALID_REQUEST'); pm.expect(body.status).to.eql(400); });"
      ]}}],
      "request": {"method": "POST", "header": [{"key": "Content-Type", "value": "application/json"}], "body": {"mode": "raw", "raw": "{\"email\":\"invalid-email\",\"password\":\"short\"}"}, "url": "{{baseUrl}}/api/v1/auth/register"}
    }
  ]
}
