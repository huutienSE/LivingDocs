{
  "info": {
    "name": "LIV-143 API-113 real Gateway S01 S04",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run each folder through scripts/test_api113_s01_integration.py --gateway-newman. Fixtures and phase changes belong to the disposable DB harness. No skipped flows. Environment contains ephemeral credentials/token and must not be committed/exported. Anonymous Gateway test checks denial only; LD-D11 RFC 9457 error body remains an external dependency, not a passing conformance claim. The Return/resubmit folder consumes existing API-120 only to prepare a real returned Draft; it does not implement or certify API-120 fresh authorization."
  },
  "item": [
    {
      "name": "01 Scoped submit",
      "item": [
        {
          "name": "01 Login Developer through Gateway",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "liv143-newman"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\": \"{{email}}\", \"password\": \"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Real S01 login yields JWT', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.code).to.eql('LOGIN_SUCCEEDED'); pm.expect(typeof b.data.accessToken).to.eql('string'); pm.variables.set('accessToken', b.data.accessToken); });",
                  "pm.test('Login is not cached', () => pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 S01 effective Developer context through Gateway",
          "request": {
            "method": "GET",
            "url": "{{gatewayUrl}}/api/v1/users/me/access-context",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "liv143-newman"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Scope comes from S01 authority', () => { pm.response.to.have.status(200); const d=pm.response.json().data; pm.expect(d.identityId).to.eql(pm.environment.get('actorId')); pm.expect(d.workspaceGrants.some(g => g.permissions.includes('DOCUMENT_AUTHOR'))).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Submit Draft through Gateway",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/api/v1/document-versions/{{newmanVersionId}}/submit",
            "header": [
              {
                "key": "X-Correlation-ID",
                "value": "liv143-newman"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              },
              {
                "key": "If-Match",
                "value": "\"{{newmanVersionId}}:revision-0\""
              },
              {
                "key": "Idempotency-Key",
                "value": "nm-first"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Atomic submit result and typed success data', () => { pm.response.to.have.status(200); const b=pm.response.json(); pm.expect(b.code).to.eql('DOCUMENT_SUBMITTED'); pm.expect(Object.keys(b).sort()).to.eql(['code','data','message']); pm.expect(b.data.versionId).to.eql(pm.environment.get('newmanVersionId')); pm.expect(b.data.state).to.eql('IN_REVIEW'); pm.expect(b.data.reviewStage).to.eql('STAFF_REVIEW'); pm.expect(b.data.revision).to.eql(1); pm.expect(b.data.sourceBinding).to.eql(null); pm.variables.set('originalSubmitBody', pm.response.text()); pm.variables.set('originalSubmitEtag', pm.response.headers.get('ETag')); });",
                  "pm.test('ETag no-store and correlation survive Gateway', () => { pm.expect(pm.response.headers.get('ETag')).to.eql(String.fromCharCode(34)+pm.environment.get('newmanVersionId')+':revision-1'+String.fromCharCode(34)); pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); pm.expect(pm.response.headers.get('X-Correlation-ID')).to.eql('liv143-newman'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Exact replay retains original receipt",
          "request": {
            "method": "POST",
            "url": "{{gatewayUrl}}/api/v1/document-versions/{{newmanVersionId}}/submit",
