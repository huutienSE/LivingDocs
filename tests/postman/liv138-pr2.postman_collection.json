                ]
              }
            }
          ]
        },
        {
          "name": "16 Document assertion needs repository",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Basic {{s04WorkloadBasic}}"
              }
            ],
            "url": "{{s01Base}}/internal/v1/auth/service-tokens",
            "body": {
              "mode": "raw",
              "raw": "{\"audience\":\"livingdocs-s01-internal\",\"operation\":\"authorization:evaluate\",\"method\":\"POST\",\"path\":\"/internal/v1/authorization/evaluate\",\"tenantId\":\"{{tenantId}}\",\"workspaceId\":\"{{workspaceId}}\",\"action\":\"DOCUMENT_AUTHOR\",\"actorTokenSha256\":\"{{actorTokenSha256}}\"}",
              "options": {
