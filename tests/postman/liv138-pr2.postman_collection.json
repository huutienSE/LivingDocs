                ]
              }
            }
          ]
        },
        {
          "name": "15 Service token for unallowlisted Tenant denied",
          "request": {
            "method": "POST",
            "url": "{{s01Base}}/internal/v1/auth/service-tokens",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{s02WorkloadBasic}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
