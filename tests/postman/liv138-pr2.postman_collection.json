                ]
              }
            }
          ]
        },
        {
          "name": "17 Issue S04 Document assertion with repository scope",
          "request": {
            "method": "POST",
            "url": "{{s01Base}}/internal/v1/auth/service-tokens",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{s04WorkloadBasic}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Only checks Service JWT issuance policy. The repository UUID is an S01 PENDING-grant reference, not S02 binding evidence.",
            "body": {
              "mode": "raw",
              "raw": "{\"audience\":\"livingdocs-s01-internal\",\"operation\":\"authorization:evaluate\",\"method\":\"POST\",\"path\":\"/internal/v1/authorization/evaluate\",\"tenantId\":\"{{tenantId}}\",\"workspaceId\":\"{{workspaceId}}\",\"action\":\"DOCUMENT_AUTHOR\",\"actorTokenSha256\":\"{{actorTokenSha256}}\",\"repositoryConnectionId\":\"{{repositoryConnectionId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('S04 Document assertion issued', () => { pm.response.to.have.status(200); pm.variables.set('documentServiceJwt', pm.response.json().data.accessToken); });"
                ]
              }
            }
          ]
        },
        {
          "name": "18 API-039 Document authority DENY without effective grant",
          "request": {
            "method": "POST",
            "url": "{{s01Base}}/internal/v1/authorization/evaluate",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userJwt}}"
              },
              {
                "key": "X-LD-Service-Assertion",
                "value": "Bearer {{documentServiceJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "B has no effective grant for this repository reference. A PENDING grant for another membership cannot authorize B.",
            "body": {
              "mode": "raw",
              "raw": "{\"action\":\"DOCUMENT_AUTHOR\",\"tenantId\":\"{{tenantId}}\",\"workspaceId\":\"{{workspaceId}}\",\"repositoryConnectionId\":\"{{repositoryConnectionId}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Document without effective grant DENY', () => { pm.response.to.have.status(200); const b = pm.response.json(); pm.expect(b.code).to.eql('AUTHORIZATION_EVALUATED'); pm.expect(b.data.decision).to.eql('DENY'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "19 Issue S03 source resolve JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{s03WorkloadBasic}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{s01Base}}/internal/v1/auth/service-tokens",
            "body": {
              "mode": "raw",
              "raw": "{\"audience\":\"livingdocs-s02-internal\",\"method\":\"POST\",\"tenantId\":\"{{tenantId}}\",\"workspaceId\":\"{{workspaceId}}\",\"repositoryConnectionId\":\"{{repositoryConnectionId}}\",\"operation\":\"source:resolve\",\"path\":\"/internal/v1/source/resolve\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Issue S03 source resolve JWT', () => { pm.response.to.have.status(200); const data = pm.response.json().data; pm.expect(data.tokenType).to.eql('Bearer'); pm.expect(data.expiresIn).to.eql(60); pm.expect(data.accessToken.split('.')).to.have.length(3); const jwtPayload = JSON.parse(CryptoJS.enc.Utf8.stringify(CryptoJS.enc.Base64.parse(data.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')))); pm.expect(jwtPayload.sub).to.eql('workload:s03'); pm.expect(jwtPayload.token_use).to.eql('service'); pm.expect(jwtPayload.operation).to.eql('source:resolve'); pm.expect(jwtPayload.aud).to.include('livingdocs-s02-internal'); pm.expect(jwtPayload.repository_connection_id).to.eql(pm.environment.get('repositoryConnectionId')); pm.expect(jwtPayload.actor_token_sha256).to.be.undefined; });"
                ]
              }
            }
          ]
        },
        {
          "name": "20 Issue S04 source validate JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{s04WorkloadBasic}}"
              },
              {
