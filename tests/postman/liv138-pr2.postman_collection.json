          "name": "12 Invalid workload secret",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Basic {{invalidWorkloadBasic}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{s01Base}}/internal/v1/auth/service-tokens",
            "body": {
              "mode": "raw",
              "raw": "{\"audience\":\"livingdocs-s01-internal\",\"operation\":\"authorization:evaluate\",\"method\":\"POST\",\"path\":\"/internal/v1/authorization/evaluate\",\"tenantId\":\"{{tenantId}}\",\"workspaceId\":\"{{workspaceId}}\",\"action\":\"REPOSITORY_CONNECT\",\"actorTokenSha256\":\"{{actorTokenSha256}}\"}",
