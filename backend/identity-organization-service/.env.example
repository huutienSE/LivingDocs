# S01 - Identity & Organization
# Copy thành .env rồi thay mật khẩu thực tế.

SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=db

# PostgreSQL local
DB_URL=jdbc:postgresql://127.0.0.1:5432/livingdocs
DB_SCHEMA=identity

# Tài khoản ứng dụng S01
DB_USERNAME=ld_s01_app
DB_PASSWORD=CHANGE_ME_S01_APP_PASSWORD

# Tài khoản thực hiện Flyway migration S01
FLYWAY_USERNAME=ld_s01_migrator
FLYWAY_PASSWORD=CHANGE_ME_S01_FLYWAY_PASSWORD

# Redis local
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT contract
JWT_ISSUER=urn:livingdocs:s01
JWT_AUDIENCE=livingdocs-api

# Local: dùng đường dẫn tuyệt đối tới PEM files ngoài Git.
# Docker Compose tự sử dụng /run/secrets qua bind mount.
JWT_PRIVATE_KEY_PATH=/ABSOLUTE/PATH/TO/livingdocs-secrets/s01_jwt_private.pem
JWT_PUBLIC_KEY_PATH=/ABSOLUTE/PATH/TO/livingdocs-secrets/s01_jwt_public.pem

# Chỉ cấu hình khi đang thực hiện key rotation.
JWT_PREVIOUS_PUBLIC_KEY_PATH=

# HMAC pepper file, ít nhất 32 random bytes.
LOGIN_RATE_LIMIT_PEPPER_PATH=/ABSOLUTE/PATH/TO/livingdocs-secrets/s01_login_rate_pepper

S01_WORKLOAD_REGISTRY_PATH=
# Chỉ dùng cho localhost/dev; production cần internal TLS và false.
S01_INTERNAL_ALLOW_INSECURE_TRANSPORT=true

# S02 authoritative binding lookup (LIV-155). Production requires HTTPS.
S02_BINDING_BASE_URL=https://s02.internal.example
S02_BINDING_PATH=/internal/v1/repository-bindings/verify
S02_BINDING_AUDIENCE=livingdocs-s02-internal
S02_BINDING_OPERATION=repository-binding:verify
S02_BINDING_TIMEOUT_MS=1500
S02_BINDING_ALLOW_HTTP=false
