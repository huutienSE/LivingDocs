# S01 - Identity & Organization
# Copy thành .env rồi thay mật khẩu thực tế.

SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=db

# PostgreSQL local
DB_URL=jdbc:postgresql://127.0.0.1:5432/livingdocs
DB_SCHEMA=identity

# Tài khoản ứng dụng S01
DB_USERNAME=ld_s01_app
DB_PASSWORD=CHANGE_ME_S01_APP_PASSWORD

# Tài khoản thực hiện Flyway migration S01
FLYWAY_USERNAME=ld_s01_migrator
FLYWAY_PASSWORD=CHANGE_ME_S01_FLYWAY_PASSWORD