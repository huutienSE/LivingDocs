# S02 - Repository Integration

SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=db

# Ngân sách toàn yêu cầu API-069/070, đơn vị giây.
LIVINGDOCS_SOURCE_REQUEST_TIMEOUT_SECONDS=15

# PostgreSQL local
DB_URL=jdbc:postgresql://127.0.0.1:5432/livingdocs
DB_SCHEMA=repository

# Tài khoản ứng dụng S02
DB_USERNAME=ld_s02_app
DB_PASSWORD=CHANGE_ME_S02_APP_PASSWORD

# Tài khoản Flyway S02
FLYWAY_USERNAME=ld_s02_migrator
FLYWAY_PASSWORD=CHANGE_ME_S02_FLYWAY_PASSWORD

# GitHub App thử nghiệm: điền Client ID ở trang cấu hình App.
LIVINGDOCS_SOURCE_GITHUB_CLIENTID=
# Đường dẫn thư mục ngoài repository chứa khóa .pem. Dùng dấu / trên Windows.
LIVINGDOCS_SOURCE_GITHUB_KEYDIRECTORY=C:/Users/admin/.livingdocs-secrets/github
# Trạng thái kết nối GitHub đã được cấp quyền trong môi trường thử nghiệm.
LIVINGDOCS_SOURCE_LOOKUP_GITHUBREADYSTATUSES=CONNECTED

# Kiểm thử GitHub thật, chỉ chạy khi bật -Dlivingdocs.github.live=true.
# ID dành riêng cho src/test/resources/liv122/github-live-fixture.sql.
LIV122_TEST_TENANT_ID=12200000-0000-4000-8000-000000000001
LIV122_TEST_WORKSPACE_ID=12200000-0000-4000-8000-000000000002
LIV122_TEST_CONNECTION_ID=12200000-0000-4000-8000-000000000004
LIV122_TEST_REF=refs/heads/main
# Sao chép SHA đầy đủ 40 ký tự của đầu nhánh từ GitHub trước khi chạy.
LIV122_TEST_EXPECTED_SHA=
