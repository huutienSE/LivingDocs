# S02 - Repository Integration

SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=db

# Ngân sách toàn yêu cầu API-069/070, đơn vị giây.
LIVINGDOCS_SOURCE_REQUEST_TIMEOUT_SECONDS=15

# LIV-151: human JWT trust is separate from source workload JWT trust.
# URLs must be pinned HTTPS endpoints. Leave blank until the deployment is configured.
LIVINGDOCS_GITHUB_AUTHORIZATION_JWK_SET_URI=
LIVINGDOCS_GITHUB_AUTHORIZATION_S01_BASE_URI=
# Public App identity; the required profile is github-app-profile-v1.
LIVINGDOCS_GITHUB_AUTHORIZATION_APP_ID=
LIVINGDOCS_GITHUB_AUTHORIZATION_APP_SLUG=
LIVINGDOCS_GITHUB_AUTHORIZATION_APP_NAME=
# Reuse the App tested in LIV-122. Leave this override unset to inherit SOURCE_GITHUB_CLIENTID.
# LIVINGDOCS_GITHUB_AUTHORIZATION_CLIENT_ID=
# Mounted file reference only; never put a client secret value here.
LIVINGDOCS_GITHUB_AUTHORIZATION_CLIENT_SECRET_PATH=
# Exact same HTTPS origin; callback path must match the registered GitHub App callback.
LIVINGDOCS_GITHUB_AUTHORIZATION_BROWSER_ORIGIN=
LIVINGDOCS_GITHUB_AUTHORIZATION_CALLBACK_URI=
LIVINGDOCS_GITHUB_AUTHORIZATION_COMPLETION_URI=
# Separate directories/key material. Each version file is <version>.key: Base64 of 32 random bytes.
# Preserve old versions while unexpired contexts still use them. Do not reuse the App signing key.
LIVINGDOCS_GITHUB_AUTHORIZATION_STATE_KEY_DIRECTORY=
LIVINGDOCS_GITHUB_AUTHORIZATION_CREDENTIAL_KEY_DIRECTORY=
LIVINGDOCS_GITHUB_AUTHORIZATION_STATE_KEY_VERSION=v1
LIVINGDOCS_GITHUB_AUTHORIZATION_CREDENTIAL_KEY_VERSION=v1
LIVINGDOCS_GITHUB_AUTHORIZATION_CONTEXT_TTL_SECONDS=900
LIVINGDOCS_GITHUB_AUTHORIZATION_CLEANUP_ENABLED=true
LIVINGDOCS_GITHUB_AUTHORIZATION_CLEANUP_DELAY_MS=30000
# Controlled local tests only; never enable on a deployed/public HTTP listener.
LIVINGDOCS_GITHUB_AUTHORIZATION_ALLOW_LOCAL_HTTP=false

# PostgreSQL local
# Optional filename inside the existing Source GitHub key directory; unset selects its only .pem file.
# LIVINGDOCS_GITHUB_AUTHORIZATION_APP_KEY_REFERENCE=livingdocs.pem

# PostgreSQL local
DB_URL=jdbc:postgresql://127.0.0.1:5432/livingdocs
DB_SCHEMA=repository

# Tài khoản ứng dụng S02
DB_USERNAME=ld_s02_app
DB_PASSWORD=CHANGE_ME_S02_APP_PASSWORD

# Tài khoản Flyway S02
FLYWAY_USERNAME=ld_s02_migrator
FLYWAY_PASSWORD=CHANGE_ME_S02_FLYWAY_PASSWORD

# GitHub App thử nghiệm: điền Client ID ở trang cấu hình App.
LIVINGDOCS_SOURCE_GITHUB_CLIENTID=
# Đường dẫn thư mục ngoài repository chứa khóa .pem. Dùng dấu / trên Windows.
LIVINGDOCS_SOURCE_GITHUB_KEYDIRECTORY=C:/Users/admin/.livingdocs-secrets/github
# Trạng thái kết nối GitHub đã được cấp quyền trong môi trường thử nghiệm.
LIVINGDOCS_SOURCE_LOOKUP_GITHUBREADYSTATUSES=CONNECTED

# Kiểm thử GitHub thật, chỉ chạy khi bật -Dlivingdocs.github.live=true.
# ID dành riêng cho src/test/resources/liv122/github-live-fixture.sql.
LIV122_TEST_TENANT_ID=12200000-0000-4000-8000-000000000001
LIV122_TEST_WORKSPACE_ID=12200000-0000-4000-8000-000000000002
# Tùy chọn: workspace khác cùng tenant để kiểm cách ly kết nối.
LIV122_TEST_OTHER_WORKSPACE_ID=
LIV122_TEST_CONNECTION_ID=12200000-0000-4000-8000-000000000004
LIV122_TEST_REF=refs/heads/main
# Sao chép SHA đầy đủ 40 ký tự của đầu nhánh từ GitHub trước khi chạy.
LIV122_TEST_EXPECTED_SHA=
