# S04 - Document Governance

SERVER_PORT=8084
SPRING_PROFILES_ACTIVE=db

# PostgreSQL local
DB_URL=jdbc:postgresql://127.0.0.1:5432/livingdocs
DB_SCHEMA=document

# Tài khoản ứng dụng S04
DB_USERNAME=ld_s04_app
DB_PASSWORD=CHANGE_ME_S04_APP_PASSWORD

# Tài khoản Flyway S04
FLYWAY_USERNAME=ld_s04_migrator
FLYWAY_PASSWORD=CHANGE_ME_S04_FLYWAY_PASSWORD

# S01 Identity JWT and API-038 authority lookup (local development only).
S01_ISSUER_URI=urn:livingdocs:s01
S01_JWK_SET_URI=http://127.0.0.1:8081/.well-known/jwks.json
S04_TOKEN_AUDIENCE=livingdocs-api
S01_REVIEW_ACCESS_CONTEXT_URI=http://127.0.0.1:8081/api/v1/users/me/access-context
S01_AUTHORIZATION_SERVICE_TOKEN_URI=http://127.0.0.1:8081/internal/v1/auth/service-tokens
S01_AUTHORIZATION_EVALUATION_URI=http://127.0.0.1:8081/internal/v1/authorization/evaluate
# Absolute path to S04's own workload secret outside Git. Never mount S01 private keys into S04.
S04_AUTHORIZATION_WORKLOAD_SECRET_PATH=
S04_AUTHORIZATION_ALLOW_INSECURE_HTTP=true
# Legacy S01_REVIEW_SERVICE_TOKEN_URI / S01_REVIEW_AUTHORIZATION_URI / S04_REVIEW_WORKLOAD_SECRET_PATH remain fallback aliases.
# API-038 still uses S04_REVIEW_ALLOW_INSECURE_HTTP; fresh uses it only as a legacy fallback.
S04_REVIEW_ALLOW_INSECURE_HTTP=true
S01_SUBMIT_ACCESS_CONTEXT_URI=http://127.0.0.1:8081/api/v1/users/me/access-context
S04_SUBMIT_ALLOW_INSECURE_HTTP=true

# API-115 reuses review API-038 configuration unless these optional overrides are set.
# S01_REVIEW_QUEUE_ACCESS_CONTEXT_URI=https://s01.example/api/v1/users/me/access-context
# S04_REVIEW_QUEUE_ALLOW_INSECURE_HTTP=false
# Server budgets; API schema deliberately does not freeze an environment-specific hard cap.
S04_REVIEW_QUEUE_DEFAULT_PAGE_SIZE=20
S04_REVIEW_QUEUE_MAX_PAGE_SIZE=100
S04_REVIEW_QUEUE_QUERY_TIMEOUT_MS=2000

# Shared Staff read authority for API-115/API-116; falls back to existing API-038 review config.
# S01_READ_ACCESS_CONTEXT_URI=https://s01.example/api/v1/users/me/access-context
# S04_READ_ALLOW_INSECURE_HTTP=false
S04_REVIEW_CONTEXT_QUERY_TIMEOUT_MS=2000
